# ==========================================================
# Utkarsh Soft Solutions — Environment Configuration
# Copy to .env (server) / .env.local (Vite dev). NEVER commit
# real keys. Regenerate any key that has ever been shared.
# ==========================================================

# ---------- APP ----------
NODE_ENV=development
PORT=3000
VITE_APP_NAME=Utkarsh Soft Solutions
VITE_APP_URL=http://localhost:5173

# ---------- COMPANY ----------
COMPANY_NAME=Utkarsh Soft Solutions
COMPANY_TAGLINE=Build • Automate • Scale
COMPANY_LOCATION=Remote • Serving Clients Across India & Worldwide

# ---------- CONTACT ----------
CONTACT_EMAIL=utkarshsoftsolutions@gmail.com
FOUNDER_EMAIL=subhashyadav98146@gmail.com
PHONE_NUMBER=+916283844258
WHATSAPP_NUMBER=916283844258

# ---------- BUSINESS HOURS ----------
BUSINESS_HOURS=Mon-Fri 09:00-17:00 IST
SATURDAY_HOURS=Sat 10:00-16:00 IST
RESPONSE_TIME=Within 24 Business Hours

# ---------- EMAIL DELIVERY (Resend) ----------
# Required for the contact form. Get a key at https://resend.com
RESEND_API_KEY=
# Verified sender for production. Until utkarshsoftsolutions.com is
# verified in Resend, the code automatically falls back to
# "Utkarsh Soft Solutions <onboarding@resend.dev>" when this is empty.
RESEND_FROM=noreply@utkarshsoftsolutions.com
CONTACT_RECEIVER_EMAIL=utkarshsoftsolutions@gmail.com

# ---------- AI CLASSIFICATION (optional feature flag) ----------
# Leave keys empty → free rule-based classification.
# Set ONE key → AI classification with automatic rules fallback.
# ENABLE_AI_CLASSIFICATION=false force-disables AI even with keys set.
ENABLE_AI_CLASSIFICATION=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- FEATURE FLAGS ----------
ENABLE_EMAIL_SERVICE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CLARITY=true

# ---------- ANALYTICS (frontend, build-time; production builds only) ----------
VITE_GA_MEASUREMENT_ID=G-LP4FXNZ7CB
VITE_CLARITY_PROJECT_ID=xptmn5lo9z

# ---------- SOCIAL LINKS (frontend, build-time overrides) ----------
# Defaults live in src/config/company.ts — set these only to override.
VITE_LINKEDIN=https://www.linkedin.com/company/utkarsh-soft-solutions/
VITE_FOUNDER_LINKEDIN=https://www.linkedin.com/in/subhash-yadav-backdev
VITE_FACEBOOK=https://www.facebook.com/share/14e2ZaufKDh/
VITE_GITHUB=https://github.com/Acrto3Hil3/website-utkarshsoftsolutions
VITE_PORTFOLIO=
VITE_WHATSAPP=https://wa.me/916283844258

# ---------- SEO ----------
DEFAULT_TITLE=Utkarsh Soft Solutions
