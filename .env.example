# ============================================================
# Utkarsh Soft Solutions — environment configuration
# Copy to .env (server) — never commit real keys.
# Frontend values (VITE_*) are baked in at build time.
# ============================================================

# --- Server ---
PORT=3000

# --- Company ---
COMPANY_NAME=Utkarsh Soft Solutions
CONTACT_EMAIL=utkarshsoftsolutions@gmail.com
# Verified Resend sender. Before domain verification you can use:
#   Utkarsh Soft Solutions <onboarding@resend.dev>
FROM_EMAIL="Utkarsh Soft Solutions <noreply@utkarshsoftsolutions.com>"
PHONE=+91 62838 44258

# --- Email delivery (Resend, required for the contact form) ---
RESEND_API_KEY=

# --- AI classification (OPTIONAL feature flag) ---
# Leave both empty → free, deterministic rule-based classification.
# Set ONE of them → inquiries are classified by AI, with automatic
# fallback to rules on any error.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides:
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Frontend (VITE_*) — set before `npm run build`
# ============================================================

# --- Social links (fall back to src/lib/site-config.ts defaults) ---
VITE_LINKEDIN=
VITE_GITHUB=
VITE_PORTFOLIO=
VITE_WHATSAPP=https://wa.me/916283844258

# --- Analytics (OPTIONAL — scripts load only when an ID is set) ---
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
